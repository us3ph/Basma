{
  "backbone": "facebook/dinov2-with-registers-base",
  "freeze_blocks": 4,
  "batch_size": 48,
  "n_crops": 1,
  "epochs": 2,
  "lr_backbone": 3e-5,
  "lr_head": 5e-4,
  "layer_decay": 0.85,
  "weight_decay": 0.05,
  "warmup_steps": 300,
  "max_hours": 3.3,
  "eval_every": 1000,
  "fp16": true,
  "workers": 4,
  "val_limit": 1500,
  "eval_conditions": ["clean", "social", "screenshot"],
  "data_dirs": ["/kaggle/input/basma-data-cf", "/kaggle/input/basma-data-recent", "/kaggle/input/basma-data-eval"],
  "img_root": "/tmp/basma_img",
  "out": "runs/kaggle_base"
}
